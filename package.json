{
  "name": "POS-CAFE",
  "version": "0.0.0",
  "private": true,
  "description": "Cafe POS — modular point-of-sale platform built on the generic ERP kernel (Phases 0–7: kernel + finance + accounting + inventory + invoicing + receipts/payments + expenses/procurement + reporting + cash sessions). Cafe vertical: P3 receipts, P4 modifiers/combos, P5 KDS, P6 hardware, P7 loyalty/credit/tabs, P9 stock policy, P11 offline, Digital Menu.",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "shared:build": "pnpm --filter @erp/shared build",
    "dev:api": "pnpm --filter @erp/shared build && pnpm --filter @erp/api start:dev",
    "dev:web": "pnpm --filter @erp/web dev",
    "db:up": "docker compose up -d db",
    "db:generate": "pnpm --filter @erp/api db:generate",
    "db:migrate": "pnpm --filter @erp/api db:migrate",
    "db:seed": "pnpm --filter @erp/api db:seed",
    "db:reset": "pnpm --filter @erp/api db:reset",
    "lint": "pnpm -r lint",
    "lint:arch": "depcruise \"apps/api/src/**/*.ts\" --config .dependency-cruiser.cjs",
    "gen:vertical": "node scripts/gen-vertical.mjs",
    "test": "pnpm -r test",
    "test:e2e": "vitest run tests/e2e",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm lint:arch && pnpm shared:build && pnpm typecheck && pnpm --filter @erp/api test",
    "test:pos:stage1": "node scripts/test-pos-stage1.cjs",
    "test:pos:recovery": "vitest run --config vitest.pos.config.ts",
    "audit:pos:preflight": "node scripts/pos-release-preflight.cjs",
    "release:gate": "node scripts/release-gate.cjs",
    "test:sim": "node scripts/run-simulation.cjs",
    "test:sim:quick": "node scripts/run-simulation.cjs --quick",
    "test:sim:mutants": "node apps/api/test/business-simulation/run-mutants.cjs",
    "sim:dr-drill": "node scripts/dr-drill.cjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@nestjs/core"
    ],
    "overrides": {
      "axios": ">=1.18.0",
      "brace-expansion": ">=5.0.9",
      "minimatch@3>brace-expansion": "^1.1.21",
      "js-yaml": ">=4.3.1",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.18",
      "multer": ">=2.2.0",
      "body-parser": ">=2.3.0",
      "dompurify": ">=3.4.12",
      "qs": ">=6.16.0",
      "uuid": ">=11.1.1"
    }
  },
  "devDependencies": {
    "@types/pg": "^8.20.2",
    "dependency-cruiser": "^17.4.3",
    "dotenv": "^16.6.1",
    "fake-indexeddb": "^6.2.5",
    "pg": "^8.22.0",
    "tsx": "^4.23.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "web": "^0.0.2",
    "web-push": "^3.6.7"
  }
}
