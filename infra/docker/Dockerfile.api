# Multi-stage Dockerfile for the API (Node 20+).
# Build stage compiles TS; production stage runs the compiled JS as non-root.

FROM node:26-alpine AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile --ignore-scripts

FROM node:26-alpine AS build
WORKDIR /app
RUN corepack enable
COPY --from=deps /app /app
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/api apps/api
RUN pnpm --filter @erp/shared build
RUN pnpm --filter @erp/api db:generate
RUN pnpm --filter @erp/api build

FROM node:26-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable && \
    addgroup -S cafe-pos && adduser -S cafe-pos -G cafe-pos && \
    apk add --no-cache tini
# Ship the ALREADY-BUILT artifacts from the build stage rather than reinstalling
# and rebuilding at runtime. The previous runtime stage ran
# `pnpm install --prod ... && pnpm --filter @erp/shared build`, but TypeScript is
# a devDependency and `--ignore-scripts` also skips Prisma client generation, so
# that command could not produce a working image. Copying the build stage's
# node_modules brings the generated Prisma client and the compiled shared package
# with it — no runtime compilation, no missing engine.
COPY --from=build /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/shared/package.json packages/shared/package.json
COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY --from=build /app/packages/shared/node_modules packages/shared/node_modules
COPY --from=build /app/apps/api/package.json apps/api/package.json
COPY --from=build /app/apps/api/dist apps/api/dist
COPY --from=build /app/apps/api/prisma apps/api/prisma
COPY --from=build /app/apps/api/node_modules apps/api/node_modules
RUN mkdir -p /app/var/uploads && chown -R cafe-pos:cafe-pos /app
USER cafe-pos
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -qO- http://localhost:3000/api/v1/health/live || exit 1
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/api/dist/main.js"]
